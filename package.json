{
  "name": "wbst",
  "version": "0.0.1",
  "description": "A personal website.",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --framework-inference=false",
    "build": "turbo run build",
    "typegen": "turbo run typegen",
    "tsc": "turbo run tsc",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "check": "turbo run format lint tsc"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "26.6.4",
    "@wbst/oxlint-config": "workspace:*",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-plugin-react-doctor": "0.9.17",
    "oxlint-tsgolint": "7.0.2003",
    "railway": "3.13.0",
    "turbo": "2.11.7",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": "1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "esbuild",
    "unrs-resolver"
  ]
}
